<%
  let totalHrs = 0;
  PILLARS.forEach(p => {
    const hoursField = p.key + '_hours';
    totalHrs += existing ? (existing[hoursField] || 0) : 0;
  });
  const pct = Math.min(100, Math.round((totalHrs / hourTarget) * 100));
%>

<div class="daily-log-page">
  <div class="card daily-log-card">
    <div class="log-toolbar">
      <h2 class="log-title">Daily Log</h2>
      <form method="get" action="/daily-log" class="log-filters">
        <select name="founder" id="founder" aria-label="Founder" onchange="this.form.submit()">
          <% founders.forEach(f => { %>
            <option value="<%= f.id %>" <%= f.id === selectedFounderId ? 'selected' : '' %>><%= f.name %> (<%= f.role %>)</option>
          <% }) %>
        </select>
        <input type="date" name="date" id="date" aria-label="Date" value="<%= date %>" onchange="this.form.submit()" />
      </form>
      <div class="log-progress" title="<%= totalHrs.toFixed(1) %> / <%= hourTarget %> hours">
        <span class="log-progress-num"><%= totalHrs.toFixed(1) %><span class="log-progress-of">/<%= hourTarget %></span></span>
        <div class="hours-bar log-progress-bar"><div style="width:<%= pct %>%"></div></div>
      </div>
      <button type="submit" form="daily-log-form" class="btn small">Save</button>
    </div>

    <form id="daily-log-form" method="post" action="/daily-log" class="log-form">
      <input type="hidden" name="date" value="<%= date %>" />
      <input type="hidden" name="founder_id" value="<%= selectedFounderId %>" />

      <div class="pillar-log-grid">
        <div class="pillar-log-head">
          <span>Pillar</span>
          <span>Hrs</span>
          <span>Evidence</span>
        </div>
        <% PILLARS.forEach(p => {
          const hoursField = p.key + '_hours';
          const evField = p.key + '_evidence';
          const hoursVal = existing ? existing[hoursField] : 0;
          const evVal = existing ? existing[evField] : '';
        %>
          <div class="pillar-log-row">
            <span class="pillar-log-label"><span class="ico"><%= p.emoji %></span> <%= p.label %></span>
            <input type="number" step="0.25" min="0" max="16" name="<%= hoursField %>" id="<%= hoursField %>" value="<%= hoursVal %>" aria-label="<%= p.label %> hours" class="pillar-hours-input" />
            <input type="text" name="<%= evField %>" id="<%= evField %>" value="<%= evVal %>" placeholder="What moved forward?" aria-label="<%= p.label %> evidence" class="pillar-evidence-input" />
          </div>
        <% }) %>
      </div>

      <div class="log-wrapup">
        <div class="wrapup-field">
          <label for="biggest_outcome">Biggest outcome</label>
          <input type="text" name="biggest_outcome" id="biggest_outcome" value="<%= existing ? existing.biggest_outcome : '' %>" placeholder="One line" />
        </div>
        <div class="wrapup-field">
          <label for="biggest_problem">Biggest problem</label>
          <input type="text" name="biggest_problem" id="biggest_problem" value="<%= existing ? existing.biggest_problem : '' %>" placeholder="One line" />
        </div>
        <div class="wrapup-field">
          <label for="decision_tomorrow">Tomorrow's decision</label>
          <input type="text" name="decision_tomorrow" id="decision_tomorrow" value="<%= existing ? existing.decision_tomorrow : '' %>" placeholder="One line" />
        </div>
      </div>
    </form>

    <details class="log-history">
      <summary>Last 14 days</summary>
      <% if (history.length === 0) { %>
        <p class="muted small">No logs yet.</p>
      <% } else { %>
        <div class="log-history-list">
          <% history.slice().reverse().forEach(l => {
            const total = l.revenue_hours + l.product_hours + l.distribution_hours + l.infrastructure_hours + l.learning_hours;
          %>
            <a class="log-history-row" href="/daily-log?date=<%= l.date %>&founder=<%= l.founder_id %>">
              <span class="log-history-date"><%= formatDateNice(l.date) %></span>
              <span class="log-history-founder"><%= l.founder_role %></span>
              <span class="log-history-hrs"><%= total.toFixed(1) %>/<%= hourTarget %></span>
              <span class="log-history-outcome muted"><%= l.biggest_outcome || '—' %></span>
            </a>
          <% }) %>
        </div>
      <% } %>
    </details>
  </div>
</div>

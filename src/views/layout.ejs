<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== 'undefined' ? title + ' · KFOS' : 'KFOS' %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="topbar">
    <a class="brand" href="/">
      KFOS
      <small><%= companyName %> Founder Operating System</small>
    </a>
    <nav>
      <a href="/" class="<%= active === 'today' ? 'active' : '' %>">Today</a>
      <a href="/commitments" class="<%= active === 'commitments' ? 'active' : '' %>">Commitments</a>
      <a href="/daily-log" class="<%= active === 'daily-log' ? 'active' : '' %>">Daily Log</a>
      <a href="/weekly" class="<%= active === 'weekly' ? 'active' : '' %>">Weekly Log</a>
      <a href="/scorecard" class="<%= active === 'scorecard' ? 'active' : '' %>">Scorecard</a>
      <a href="/settings" class="<%= active === 'settings' ? 'active' : '' %>">Settings</a>
    </nav>
  </div>
  <div class="container">
    <% if (typeof flash !== 'undefined' && flash) { %>
      <div class="flash"><%= flash %></div>
    <% } %>
    <%- body %>
  </div>
</body>
</html>

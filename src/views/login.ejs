<div class="card login-card">
  <h2>Sign in to KFOS</h2>

  <% if (error) { %>
    <div class="flash flash-error"><%= error %></div>
  <% } %>

  <% if (mode === 'email' || mode === 'notfound') { %>
    <% if (mode === 'notfound') { %>
      <p class="small muted">No account found for <strong><%= email %></strong>. Check the email your team gave you.</p>
    <% } else { %>
      <p class="small muted">Enter the email your team set up for you.</p>
    <% } %>
    <form method="get" action="/login">
      <label for="email">Email</label>
      <input type="email" name="email" id="email" required autofocus value="<%= email %>" />
      <% if (next) { %><input type="hidden" name="next" value="<%= next %>" /><% } %>
      <button class="btn" type="submit">Continue</button>
    </form>
  <% } %>

  <% if (mode === 'claim') { %>
    <p class="small muted">First time signing in as <strong><%= email %></strong> — choose a password. This becomes your login from now on, tied to everything you log or commit to.</p>
    <form method="post" action="/login">
      <input type="hidden" name="mode" value="claim" />
      <input type="hidden" name="email" value="<%= email %>" />
      <% if (next) { %><input type="hidden" name="next" value="<%= next %>" /><% } %>
      <label for="password">Choose a password (min <%= minPasswordLength %> characters)</label>
      <input type="password" name="password" id="password" required minlength="<%= minPasswordLength %>" autofocus />
      <label for="confirm">Confirm password</label>
      <input type="password" name="confirm" id="confirm" required minlength="<%= minPasswordLength %>" />
      <button class="btn" type="submit">Set password &amp; sign in</button>
    </form>
    <p class="small"><a href="/login">Not you? Use a different email</a></p>
  <% } %>

  <% if (mode === 'signin') { %>
    <p class="small muted">Welcome back, <strong><%= founder.name %></strong> (<%= founder.role %>).</p>
    <form method="post" action="/login">
      <input type="hidden" name="mode" value="signin" />
      <input type="hidden" name="email" value="<%= email %>" />
      <% if (next) { %><input type="hidden" name="next" value="<%= next %>" /><% } %>
      <label for="password">Password</label>
      <input type="password" name="password" id="password" required autofocus />
      <button class="btn" type="submit">Sign in</button>
    </form>
    <p class="small"><a href="/login">Not you? Use a different email</a></p>
  <% } %>
</div>

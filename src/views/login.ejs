<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Sign in · KFOS</title>
  <script>
    (function () {
      try {
        var stored = localStorage.getItem('kfos-theme');
        var theme = stored || (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {}
    })();
  </script>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='7' fill='%230071e3'/><text x='16' y='22' font-family='-apple-system,sans-serif' font-size='16' font-weight='700' fill='white' text-anchor='middle'>K</text></svg>" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="login-body">
  <main class="login-shell">
    <div class="login-card">
      <div class="login-brand">
        <span class="brand-mark">K</span>
        <div>
          <strong>KFOS</strong>
          <span class="muted small"><%= companyName %> Founder Operating System</span>
        </div>
      </div>
      <h1>Sign in</h1>
      <p class="muted small">Shared team login. Same username and password for everyone.</p>

      <% if (error) { %>
        <div class="flash login-error"><%= error %></div>
      <% } %>

      <form method="post" action="/login" class="login-form" id="login-form">
        <input type="hidden" name="next" value="<%= next %>" />
        <input type="hidden" name="eventId" id="eventId" value="" />
        <input type="hidden" name="visitorId" id="visitorId" value="" />
        <label for="username">Username</label>
        <input type="text" name="username" id="username" autocomplete="username" required autofocus />
        <label for="password">Password</label>
        <input type="password" name="password" id="password" autocomplete="current-password" required />
        <button class="btn" type="submit" id="login-submit">Continue</button>
      </form>

      <% if (keverdEnabled) { %>
        <p class="muted small login-device" id="keverd-status">Checking device…</p>
      <% } %>
    </div>
  </main>

  <% if (keverdEnabled) { %>
  <script type="module">
    (function () {
      var publicKey = <%- JSON.stringify(keverdPublicKey) %>;
      var statusEl = document.getElementById('keverd-status');
      var eventInput = document.getElementById('eventId');
      var visitorInput = document.getElementById('visitorId');
      var form = document.getElementById('login-form');
      var submitBtn = document.getElementById('login-submit');
      var collectPromise = null;

      function setStatus(text) {
        if (statusEl) statusEl.textContent = text;
      }

      async function collect() {
        if (!publicKey) return null;
        var mod = await import('https://cdn.keverd.com/v1/' + encodeURIComponent(publicKey) + '/keverd.min.js');
        var agent = await mod.start();
        var result = await agent.getVisitorData();
        var eventId = result.requestId || result.event_id || '';
        var visitorId = result.visitorId || result.fingerprint || '';
        if (eventInput) eventInput.value = eventId;
        if (visitorInput) visitorInput.value = visitorId;
        setStatus(visitorId ? ('Device ' + visitorId.slice(0, 18) + '…') : 'Device ready');
        return result;
      }

      collectPromise = collect().catch(function (err) {
        console.warn('[keverd] collect failed', err);
        setStatus('Device check skipped');
        return null;
      });

      form.addEventListener('submit', function (e) {
        if (eventInput.value) return;
        e.preventDefault();
        submitBtn.disabled = true;
        setStatus('Checking device…');
        Promise.resolve(collectPromise)
          .then(function () {
            if (!eventInput.value) return collect();
          })
          .catch(function () {})
          .then(function () {
            submitBtn.disabled = false;
            form.submit();
          });
      });
    })();
  </script>
  <% } %>
</body>
</html>

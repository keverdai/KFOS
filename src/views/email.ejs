<div class="card">
  <h2>Email</h2>
  <p class="small muted">
    Nothing here sends automatically — every email below goes out only when
    someone presses one of these buttons.
    <% if (!mailerEnabled) { %>
      Not configured yet — set <code>SMTP_HOST</code>, <code>SMTP_USER</code>,
      and <code>SMTP_PASS</code> (see README) to turn this on.
    <% } %>
  </p>
</div>

<div class="card">
  <h3>Send a custom message</h3>
  <form method="post" action="/email/custom">
    <label>To</label>
    <div class="grid cols-3">
      <% founders.forEach(f => { %>
        <label style="display:flex; align-items:center; gap:6px; font-weight:normal">
          <input type="checkbox" name="recipients" value="<%= f.id %>" />
          <%= f.name %> (<%= f.role %>)<% if (!f.email) { %> <span class="small muted">— no email set</span><% } %>
        </label>
      <% }) %>
    </div>

    <label for="subject" style="margin-top:12px">Subject</label>
    <input type="text" name="subject" id="subject" required />

    <label for="message">Message</label>
    <textarea name="message" id="message" rows="6" required></textarea>

    <button class="btn" type="submit" <%= mailerEnabled ? '' : 'disabled' %>>Send</button>
  </form>
</div>

<div class="card">
  <h3>Send overdue &amp; due-soon summary</h3>
  <p class="small muted">
    Sends each selected founder their own commitments — what's overdue, what's
    due in the next 3 days, and today's session (pillar, owner, what to
    discuss). Someone with nothing to report is skipped unless you check
    "send anyway" below.
  </p>
  <form method="post" action="/email/digest">
    <label>To</label>
    <div class="grid cols-3">
      <% founders.forEach(f => { %>
        <label style="display:flex; align-items:center; gap:6px; font-weight:normal">
          <input type="checkbox" name="recipients" value="<%= f.id %>" checked />
          <%= f.name %> (<%= f.role %>)<% if (!f.email) { %> <span class="small muted">— no email set</span><% } %>
        </label>
      <% }) %>
    </div>
    <label style="display:flex; align-items:center; gap:6px; font-weight:normal; margin-top:10px">
      <input type="checkbox" name="force" value="1" />
      Send anyway, even with nothing overdue/due soon
    </label>
    <button class="btn" type="submit" style="margin-top:10px" <%= mailerEnabled ? '' : 'disabled' %>>Send summary now</button>
  </form>
</div>

<%
  const ATTENTION_LIMIT = 2;
  const overdueShow = overdue.slice(0, ATTENTION_LIMIT);
  const dueSoonShow = dueSoon.slice(0, ATTENTION_LIMIT);
%>

<div class="today-page">

  <nav class="today-date-nav" aria-label="Date">
    <a class="date-arrow" href="/today?date=<%= prevDate %>" aria-label="Previous day">&larr;</a>
    <div class="date-label">
      <strong><%= formatDateNice(date) %></strong>
      <% if (date !== todayStr) { %><a class="date-back" href="/today">Back to today</a><% } %>
    </div>
    <a class="date-arrow" href="/today?date=<%= nextDate %>" aria-label="Next day">&rarr;</a>
  </nav>

  <div class="card today-hero">
    <% if (isWeekend) { %>
      <p class="today-eyebrow">No session</p>
      <h1 class="today-title">Weekend</h1>
      <p class="today-lede">No pillar session runs on weekends. Use this time to rest or catch up on evidence.</p>
      <div class="today-actions">
        <a class="btn secondary" href="/daily-log?date=<%= date %>">Log hours</a>
      </div>
    <% } else { %>
      <p class="today-eyebrow">Today's pillar</p>
      <h1 class="today-title"><%- pillarTagHtml(pillar.key) %></h1>
      <p class="today-owner">Session owner · <strong><%= owner ? (owner.name + ' (' + owner.role + ')') : '—' %></strong></p>
      <p class="today-lede"><%= pillar.question %></p>
      <div class="today-actions">
        <a class="btn" href="/sessions/<%= date %>"><%= session ? 'Open session' : 'Start session' %></a>
        <a class="btn secondary" href="/daily-log?date=<%= date %>">Log hours</a>
      </div>
    <% } %>
  </div>

  <section class="today-section">
    <div class="section-head">
      <h2>Team today</h2>
      <span class="section-meta"><%= todaysLogs.length %>/<%= founders.length %> logged</span>
    </div>
    <div class="founder-cards">
      <% founders.forEach(f => {
        const log = todaysLogs.find(l => l.founder_id === f.id);
        const total = log ? (log.revenue_hours + log.product_hours + log.distribution_hours + log.infrastructure_hours + log.learning_hours) : 0;
        const pct = Math.min(100, Math.round((total / hourTarget) * 100));
        const done = total >= hourTarget;
      %>
        <a class="founder-card<%= done ? ' complete' : '' %>" href="/daily-log?date=<%= todayStr %>&founder=<%= f.id %>">
          <div class="founder-card-top">
            <span class="founder-name"><%= f.name %></span>
            <span class="founder-role"><%= f.role %></span>
          </div>
          <div class="founder-hours"><%= total.toFixed(1) %> <span class="founder-hours-of">/ <%= hourTarget %> hrs</span></div>
          <div class="hours-bar"><div style="width:<%= pct %>%"></div></div>
          <span class="founder-card-cta"><%= log ? 'Edit log' : 'Add log' %> &rarr;</span>
        </a>
      <% }) %>
    </div>
  </section>

  <section class="today-section">
    <div class="section-head">
      <h2>Needs attention</h2>
    </div>
    <div class="attention-grid">

      <div class="card attention-card<%= overdue.length ? ' attention-urgent' : '' %>">
        <h3><span class="attention-icon">⚠️</span> Overdue <span class="count"><%= overdue.length %></span></h3>
        <% if (overdue.length === 0) { %>
          <p class="empty-state">Nothing overdue.</p>
        <% } else { %>
          <ul class="commitment-list">
            <% overdueShow.forEach(c => { const f = founders.find(f=>f.id===c.owner_founder_id); %>
              <li class="commitment-item">
                <div class="commitment-item-main">
                  <a href="/commitments#c<%= c.id %>"><%= c.description %></a>
                  <span class="commitment-meta"><%= f ? f.role : '—' %> · <%= formatDateNice(c.due_date) %></span>
                </div>
                <%- pillarTagHtml(c.pillar) %>
              </li>
            <% }) %>
          </ul>
          <% if (overdue.length > ATTENTION_LIMIT) { %>
            <a class="attention-more" href="/commitments?attention=overdue">View all <%= overdue.length %> overdue &rarr;</a>
          <% } %>
        <% } %>
      </div>

      <div class="card attention-card">
        <h3><span class="attention-icon">⏳</span> Due soon <span class="count"><%= dueSoon.length %></span></h3>
        <% if (dueSoon.length === 0) { %>
          <p class="empty-state">Nothing due in the next 3 days.</p>
        <% } else { %>
          <ul class="commitment-list">
            <% dueSoonShow.forEach(c => { const f = founders.find(f=>f.id===c.owner_founder_id); %>
              <li class="commitment-item">
                <div class="commitment-item-main">
                  <a href="/commitments#c<%= c.id %>"><%= c.description %></a>
                  <span class="commitment-meta"><%= f ? f.role : '—' %> · <%= formatDateNice(c.due_date) %></span>
                </div>
                <%- pillarTagHtml(c.pillar) %>
              </li>
            <% }) %>
          </ul>
          <% if (dueSoon.length > ATTENTION_LIMIT) { %>
            <a class="attention-more" href="/commitments?attention=due_soon">View all <%= dueSoon.length %> due soon &rarr;</a>
          <% } %>
        <% } %>
      </div>

    </div>
  </section>

</div>

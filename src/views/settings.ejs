<div class="card">
  <h2>Settings</h2>
</div>

<div class="card">
  <h3>Your account</h3>
  <p class="small muted">Email and password are self-service only — nobody else can change these for you, since they're what ties your logged hours and commitments to you.</p>

  <form method="post" action="/settings/account/email" class="grid cols-2" style="align-items:end">
    <div>
      <label for="account_email">Email (used to sign in)</label>
      <input type="email" name="email" id="account_email" value="<%= currentFounder.email || '' %>" required />
    </div>
    <div>
      <button class="btn small" type="submit">Update email</button>
    </div>
  </form>

  <form method="post" action="/settings/account/password" style="margin-top:16px">
    <label for="current_password">Current password</label>
    <input type="password" name="current_password" id="current_password" required />
    <div class="grid cols-2">
      <div>
        <label for="new_password">New password (min <%= minPasswordLength %> characters)</label>
        <input type="password" name="new_password" id="new_password" minlength="<%= minPasswordLength %>" required />
      </div>
      <div>
        <label for="confirm_new_password">Confirm new password</label>
        <input type="password" name="confirm_new_password" id="confirm_new_password" minlength="<%= minPasswordLength %>" required />
      </div>
    </div>
    <button class="btn small" type="submit">Change password</button>
  </form>
</div>

<div class="card">
  <h3>Founders</h3>
  <p class="small muted">Rename the seeded CEO/CTO/COO rows to your actual names. Order (sort_order) determines rotation — it's fixed at seed time. Email and password aren't editable here — see Your account above (and each founder's own Account section once they've signed in).</p>
  <% founders.forEach(f => { %>
    <form method="post" action="/settings/founders/<%= f.id %>" class="grid cols-3" style="align-items:end; margin-bottom:6px">
      <div>
        <label>Name</label>
        <input type="text" name="name" value="<%= f.name %>" />
      </div>
      <div>
        <label>Role</label>
        <input type="text" name="role" value="<%= f.role %>" />
      </div>
      <div>
        <button class="btn small" type="submit">Save</button>
      </div>
    </form>
    <p class="small muted" style="margin: 0 0 14px">
      <%= f.email || 'no email set' %> ·
      <%= f.password_hash ? 'account claimed' : 'not yet signed in' %>
      <% if (f.password_hash && f.id !== currentFounder.id) { %>
        · <form method="post" action="/settings/founders/<%= f.id %>/reset-password" style="display:inline">
            <button type="submit" class="btn small secondary">Reset their password</button>
          </form>
      <% } %>
    </p>
  <% }) %>
</div>

<div class="card">
  <h3>General</h3>
  <form method="post" action="/settings/general">
    <label for="company_name">Company name</label>
    <input type="text" name="company_name" id="company_name" value="<%= companyName %>" />

    <label for="daily_hour_target">Daily hour target</label>
    <input type="number" name="daily_hour_target" id="daily_hour_target" value="<%= dailyHourTarget %>" step="0.5" min="1" max="16" />

    <label for="rotation_start_date">Rotation week 1 start (any date in that week — snaps to Monday)</label>
    <input type="date" name="rotation_start_date" id="rotation_start_date" value="<%= rotationStartDate %>" />
    <p class="small muted">This anchors the fair rotation cycle: changing it reshuffles who owns which pillar going forward.</p>

    <button class="btn" type="submit">Save</button>
  </form>
</div>

<div class="card">
  <h3>Weekday &rarr; pillar mapping</h3>
  <p class="small muted">Default cadence: Mon Revenue, Tue Product, Wed Distribution, Thu Founder Priority, Fri Learning + Review.</p>
  <form method="post" action="/settings/weekday-pillars" class="grid cols-5">
    <% ['Mon','Tue','Wed','Thu','Fri'].forEach((label, i) => { const day = i+1; %>
      <div>
        <label><%= label %></label>
        <select name="day<%= day %>">
          <% allPillars.forEach(p => { %>
            <option value="<%= p.key %>" <%= weekdayPillarMap[day] === p.key ? 'selected' : '' %>><%= p.label %></option>
          <% }) %>
        </select>
      </div>
    <% }) %>
    <div style="grid-column: 1 / -1">
      <button class="btn" type="submit">Save mapping</button>
    </div>
  </form>
</div>
